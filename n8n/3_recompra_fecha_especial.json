        0,
        0
      ]
    },
    {
      "parameters": {
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "TU_GOOGLE_SHEET_ID"
        },
        "sheetName": {
          "__rl": true,
          "mode": "name",
          "value": "CRM"
        },
        "options": {}
      },
      "name": "Leer CRM clientes",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        220,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "\n// Clientes cuya fecha especial (cumpleaños, aniversario…) vuelve a cumplirse en 21 días.\nconst ANTICIPO = 21, hoy = new Date(); hoy.setHours(0,0,0,0);\nconst objetivo = new Date(hoy.getTime() + ANTICIPO * 86400000);\nconst md = d => `${d.getMonth()}-${d.getDate()}`;\nreturn $input.all().filter(({ json: c }) => {\n  if (!c.ultima_fecha_especial || !c.telefono) return false;\n  return md(new Date(c.ultima_fecha_especial)) === md(objetivo);\n}).map(({ json: c }) => ({ json: { ...c,\n  mensaje: `Hola ${c.nombre.split(' ')[0]} ✨ En 3 semanas se cumple un año de esa fecha especial. ` +\n           `¿Le sumamos un dije o una pulsera grabada? Pedido hoy = llega a tiempo. Responde y te asesoramos.` } }));\n"
      },
      "name": "Filtrar fechas en 21 días",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://graph.facebook.com/v20.0/TU_PHONE_NUMBER_ID/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: $json.telefono.replace(/\\D/g,''), type: 'text', text: { body: $json.mensaje } }) }}",
        "options": {}
      },
      "name": "Enviar mensaje personalizado",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        0
      ]
    },
    {
      "parameters": {
        "operation": "appendOrUpdate",
        "documentId": {
          "__rl": true,
          "mode": "id",
          "value": "TU_GOOGLE_SHEET_ID"
        },
        "sheetName": {
